PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# Same existing operator algebra; no reinterpretation of KAKU/semantic roles.
OP PNAML10.PNCS.CONTENT SOURCE typed_semantic_role_content
OP PNAML10.PNCS.IDENTITY IDENTITY PNAML10.PNCS.CONTENT
OP PNAML10.PNCS.SEQUENCE ORDER semantic_role_before semantic_role_after
OP PNAML10.PNCS.ADDRESS TRANSFORM ordered_semantic_edge PNCS_SEMANTIC_CONTENT_ADDRESS_GENERATOR_V2 typed_t36_address_pair
OP PNAML10.PNCS.BIND COMPOSITION PNAML10.PNCS.SEQUENCE PNAML10.PNCS.ADDRESS
OP PNAML10.RDSS.OCCURRENCE SOURCE rdss_exact_typed_relational_occurrence
OP PNAML10.RDSS.BRAID SOURCE rdss_ordered_braid_word_and_sector
OP PNAML10.RDSS.COMPOSE COMPOSITION PNAML10.RDSS.OCCURRENCE PNAML10.RDSS.BRAID
OP PNAML10.QHTRI.SOURCE SOURCE typed_semantic_t36_trajectory
OP PNAML10.QHTRI.DRIVE TRANSFORM PNAML10.QHTRI.SOURCE exact_one_step_inverse_dynamics_control
OP PNAML10.QHTRI.HAMILTONIAN TRANSFORM PNAML10.QHTRI.DRIVE qhtri_v3_graph_hamiltonian
OP PNAML10.QHTRI.ORDER ORDER H_k H_k_plus_1
OP PNAML10.QHTRI.BIND COMPOSITION PNAML10.QHTRI.ORDER PNAML10.QHTRI.HAMILTONIAN
OP PNAML10.MACHINE.ROUTE COMPOSITION PNAML10.PNCS.IDENTITY PNAML10.PNCS.BIND PNAML10.RDSS.COMPOSE PNAML10.QHTRI.BIND
ASSERT PNAML10.PNCS.IDENTITY
ASSERT PNAML10.RDSS.OCCURRENCE
EMIT PNAML10.MACHINE.ROUTE
# CONTRACT PNCS semantic identity is an exact typed key, never inferred from phase proximity.
# CONTRACT endpoint equality cannot replace exact braid word.
# CONTRACT no direct AUX effects or default runtime replacement.
