PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY
# PNAML11 CIEL ego episodic memory candidate; NOT registered native execution.
# Reuse existing PNV operator algebra; keep exact typed source identity and history.
OP PNAML11.EGO.EPISODE SOURCE ciel_ego_exact_source_episode
OP PNAML11.EGO.HISTORY SOURCE ciel_ego_append_only_historical_lineage
OP PNAML11.EGO.SITUATION SOURCE ciel_ego_typed_situation_scene_context_object
OP PNAML11.EGO.AUX SOURCE noema_aux_snaps_observation_receipt_source
OP PNAML11.EGO.IDENTITY IDENTITY PNAML11.EGO.EPISODE
OP PNAML11.EGO.ORDER ORDER ego_episode_before ego_episode_after
OP PNAML11.EGO.CONTEXT COMPOSITION PNAML11.EGO.SITUATION PNAML11.EGO.AUX
OP PNAML11.EGO.MEMORY COMPOSITION PNAML11.EGO.IDENTITY PNAML11.EGO.HISTORY PNAML11.EGO.ORDER PNAML11.EGO.CONTEXT
ASSERT PNAML11.EGO.IDENTITY
ASSERT PNAML11.EGO.HISTORY
EMIT PNAML11.EGO.MEMORY
# CONTRACT SOURCE FULL_EPISODE + EXACT_OCCURRENCE + ORDERED_BRAID + LIFTED_WINDING + SOURCE_ID.
# CONTRACT FINGERPRINT_IS_DERIVED_OBSERVATION_NOT_FULL_MEMORY.
# CONTRACT SAME_TAGS_DO_NOT_IDENTIFY_SAME_EPISODE.
# CONTRACT PHASE_SIMILARITY_DOES_NOT_AUTHORIZE_MEMORY_IDENTITY.
# CONTRACT AUX_SOURCE=PERSISTENT_AUX_SELF => LOCAL_VALIDATION_ONLY, NO_NATIVE_ACK.
# CONTRACT M8_PROTECTED; M10_APPEND_ONLY; NEVER_WRITE_NOEMA_CURRENT_OR_AUX.
# CONTRACT NO_NEW_PNV_OPCODES; NATIVE_SYMBOL_REGISTRATION_NOT_VERIFIED.
