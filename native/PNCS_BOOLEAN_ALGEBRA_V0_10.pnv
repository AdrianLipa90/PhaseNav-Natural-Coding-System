PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS v0.10 — Boolean equivalence closure for PURE predicate graphs only.
# This file does NOT assert that arbitrary PNV COMPOSITION is commutative/associative.
# No AND/OR/NOT opcode is introduced; these remain compositions/bindings from v0.8-v0.9.

OP K.DISTINGUISH DIFFERENCE left right
OP K.CONDITION CONDITION predicate relation reference
OP K.COMPOSE COMPOSITION left relation right
OP K.NEGATE NEGATION value
OP K.IDENTITY IDENTITY left right

# Pure comparison leaves.
OP EX.A DIFFERENCE a 1
OP EX.A.P CONDITION EX.A gt 0
OP EX.B DIFFERENCE b 2
OP EX.B.P CONDITION EX.B lt 0
OP EX.C DIFFERENCE c 3
OP EX.C.P CONDITION EX.C gt 0

# Commutativity witnesses: different structural order, same pure Boolean normal form.
OP EX.AND.AB COMPOSITION EX.A.P all EX.B.P
OP EX.AND.BA COMPOSITION EX.B.P all EX.A.P
OP EQ.AND.COMMUTATIVE IDENTITY EX.AND.AB EX.AND.BA

OP EX.OR.AB COMPOSITION EX.A.P any EX.B.P
OP EX.OR.BA COMPOSITION EX.B.P any EX.A.P
OP EQ.OR.COMMUTATIVE IDENTITY EX.OR.AB EX.OR.BA

# Associativity witnesses.
OP EX.AND.AB_C COMPOSITION EX.AND.AB all EX.C.P
OP EX.AND.BC COMPOSITION EX.B.P all EX.C.P
OP EX.AND.A_BC COMPOSITION EX.A.P all EX.AND.BC
OP EQ.AND.ASSOCIATIVE IDENTITY EX.AND.AB_C EX.AND.A_BC

# Double negation.
OP EX.NOT_A NEGATION EX.A.P
OP EX.NOT_NOT_A NEGATION EX.NOT_A
OP EQ.DOUBLE_NEGATION IDENTITY EX.NOT_NOT_A EX.A.P

# De Morgan witness.
OP EX.NOT_AB NEGATION EX.AND.AB
OP EX.NOT_B NEGATION EX.B.P
OP EX.NOT_A_OR_NOT_B COMPOSITION EX.NOT_A any EX.NOT_B
OP EQ.DE_MORGAN.AND IDENTITY EX.NOT_AB EX.NOT_A_OR_NOT_B

# Idempotence / absorption witnesses are algebraic normal-form claims for pure predicates.
OP EX.AND.AA COMPOSITION EX.A.P all EX.A.P
OP EQ.AND.IDEMPOTENT IDENTITY EX.AND.AA EX.A.P
OP EX.A_OR_B COMPOSITION EX.A.P any EX.B.P
OP EX.A_AND_AORB COMPOSITION EX.A.P all EX.A_OR_B
OP EQ.ABSORPTION IDENTITY EX.A_AND_AORB EX.A.P

EMIT EQ.AND.COMMUTATIVE EQ.OR.COMMUTATIVE EQ.AND.ASSOCIATIVE EQ.DOUBLE_NEGATION EQ.DE_MORGAN.AND EQ.AND.IDEMPOTENT EQ.ABSORPTION
