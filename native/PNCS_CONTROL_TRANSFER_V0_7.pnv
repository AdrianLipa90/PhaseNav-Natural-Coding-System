PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS v0.7 — control-transfer closure and cross-domain transfer.
# Surface IF/BELOW/ABOVE/EQUAL/THEN/GO are not machine opcodes.
# Internal GO is a control-location TRANSFORM, not ACTION_REQUEST.

OP K.DISTINGUISH DIFFERENCE left right
OP K.CONDITION CONDITION predicate relation reference
OP K.ORDER ORDER before after
OP K.TRANSFORM TRANSFORM source map target
OP K.COMPOSE COMPOSITION left relation right

# Shared scalar comparison path; comparator is an argument binding.
OP R.COMPARISON COMPOSITION K.DISTINGUISH K.CONDITION
OP R.BELOW COMPOSITION R.COMPARISON lt
OP R.ABOVE COMPOSITION R.COMPARISON gt
OP R.EQUAL COMPOSITION R.COMPARISON eq

# Promoted control radical after transfer across independent domains.
OP R.CONDITIONAL_ROUTE COMPOSITION R.COMPARISON K.ORDER K.TRANSFORM K.COMPOSE

# Gravity
OP EX.GRAVITY.DELTA DIFFERENCE gravity 0.5
OP EX.GRAVITY.PRED CONDITION EX.GRAVITY.DELTA lt 0
OP EX.GRAVITY.ROUTE TRANSFORM control_location route physics.gravity.low
OP EX.GRAVITY.ORDER ORDER EX.GRAVITY.PRED EX.GRAVITY.ROUTE
OP EX.GRAVITY.PROGRAM COMPOSITION EX.GRAVITY.PRED EX.GRAVITY.ORDER EX.GRAVITY.ROUTE

# Temperature
OP EX.TEMP.DELTA DIFFERENCE temperature 80
OP EX.TEMP.PRED CONDITION EX.TEMP.DELTA gt 0
OP EX.TEMP.ROUTE TRANSFORM control_location route cooling.emergency
OP EX.TEMP.ORDER ORDER EX.TEMP.PRED EX.TEMP.ROUTE
OP EX.TEMP.PROGRAM COMPOSITION EX.TEMP.PRED EX.TEMP.ORDER EX.TEMP.ROUTE

# Memory pressure
OP EX.MEM.DELTA DIFFERENCE memory_pressure 0.9
OP EX.MEM.PRED CONDITION EX.MEM.DELTA gt 0
OP EX.MEM.ROUTE TRANSFORM control_location route runtime.memory.relief
OP EX.MEM.ORDER ORDER EX.MEM.PRED EX.MEM.ROUTE
OP EX.MEM.PROGRAM COMPOSITION EX.MEM.PRED EX.MEM.ORDER EX.MEM.ROUTE

# Phase coherence
OP EX.PHASE.DELTA DIFFERENCE phase_coherence 0.7
OP EX.PHASE.PRED CONDITION EX.PHASE.DELTA lt 0
OP EX.PHASE.ROUTE TRANSFORM control_location route phasenav.phase.relock
OP EX.PHASE.ORDER ORDER EX.PHASE.PRED EX.PHASE.ROUTE
OP EX.PHASE.PROGRAM COMPOSITION EX.PHASE.PRED EX.PHASE.ORDER EX.PHASE.ROUTE

# Risk
OP EX.RISK.DELTA DIFFERENCE risk 0.8
OP EX.RISK.PRED CONDITION EX.RISK.DELTA gt 0
OP EX.RISK.ROUTE TRANSFORM control_location route safety.pause
OP EX.RISK.ORDER ORDER EX.RISK.PRED EX.RISK.ROUTE
OP EX.RISK.PROGRAM COMPOSITION EX.RISK.PRED EX.RISK.ORDER EX.RISK.ROUTE

# Exact scalar equality specialization
OP EX.ERROR.DELTA DIFFERENCE phase_error 0
OP EX.ERROR.PRED CONDITION EX.ERROR.DELTA eq 0
OP EX.ERROR.ROUTE TRANSFORM control_location route phasenav.locked
OP EX.ERROR.ORDER ORDER EX.ERROR.PRED EX.ERROR.ROUTE
OP EX.ERROR.PROGRAM COMPOSITION EX.ERROR.PRED EX.ERROR.ORDER EX.ERROR.ROUTE

VECTOR V.R.COMPARISON "PNCS.radical.comparison" PRECISE
VECTOR V.R.CONDITIONAL_ROUTE "PNCS.radical.conditional_route.v07" PRECISE
VECTOR V.EX.GRAVITY.PROGRAM "PNCS.example.gravity_below_route" PRECISE
VECTOR V.EX.TEMP.PROGRAM "PNCS.example.temperature_above_route" PRECISE
VECTOR V.EX.MEM.PROGRAM "PNCS.example.memory_pressure_above_route" PRECISE
VECTOR V.EX.PHASE.PROGRAM "PNCS.example.phase_coherence_below_route" PRECISE
VECTOR V.EX.RISK.PROGRAM "PNCS.example.risk_above_route" PRECISE
VECTOR V.EX.ERROR.PROGRAM "PNCS.example.phase_error_equal_route" PRECISE

EMIT R.CONDITIONAL_ROUTE
