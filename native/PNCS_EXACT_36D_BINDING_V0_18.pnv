PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS v0.18 exact 36D realization binding witness.
# Historical PNV/1 VECTOR implementation parameters/source bytes are not recovered.
# Therefore v0.18 records sourced exact bindings and does not regenerate vectors.

OP V18.SEMANTIC.CONTENT SOURCE pncs:def:sha256:registered-content
OP V18.PHASE36.EVIDENCE SOURCE phase36_sha256:registered-evidence
OP V18.BASIS.SOURCE SOURCE PNV_T36_PHASE_ANGLES_RADIANS_V1
OP V18.DERIVATION.SOURCE SOURCE EXTERNAL_EVIDENCE_BINDING_V1
OP V18.EXACT.BINDING COMPOSITION V18.SEMANTIC.CONTENT V18.PHASE36.EVIDENCE V18.BASIS.SOURCE V18.DERIVATION.SOURCE
OP V18.CONTENT.IDENTITY IDENTITY V18.SEMANTIC.CONTENT pncs:def:sha256:registered-content

# HISTORICAL_GENERATOR_REPLAY NOT_CLAIMED
# SIMILARITY_SEMANTIC_AUTHORITY FALSE
ASSERT V18.CONTENT.IDENTITY
EMIT V18.EXACT.BINDING
