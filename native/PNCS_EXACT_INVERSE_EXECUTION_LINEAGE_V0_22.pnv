PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS v0.22 exact inverse execution lineage witness.
# No new PNV opcode is introduced.
# Repository/runtime location and aliases are not semantic authority.

OP V22.RESULT.SOURCE SOURCE execution_result_receipt_v0_20
OP V22.SYSTEM.SOURCE SOURCE system_content_id
OP V22.HIERARCHY.ORDER ORDER V22.RESULT.SOURCE V22.SYSTEM.SOURCE
OP V22.HIERARCHY.IDENTITY IDENTITY exact_content_addressed_occurrence
OP V22.DEFINITION.SOURCE SOURCE definition_content_id
OP V22.RADICAL.SOURCE SOURCE exact_radical_graph
OP V22.KAKU.ORDER ORDER exact_kaku_schedule
OP V22.DEFINITION.RADICAL COMPOSITION V22.DEFINITION.SOURCE V22.RADICAL.SOURCE V22.KAKU.ORDER
OP V22.LINEAGE COMPOSITION V22.HIERARCHY.ORDER V22.HIERARCHY.IDENTITY V22.DEFINITION.RADICAL

# INVERSE_CHAIN
# RESULT -> SYSTEM -> HIGH_ORCHESTRATOR -> LOW_ORCHESTRATOR
# -> SUBSYSTEM|DAEMON -> CLUSTER -> FILE -> CLASS -> DEFINITION -> RADICAL -> KAKU
# AMBIGUITY FAIL_CLOSED_UNLESS_EXACT_OCCURRENCE_SELECTED
# CHILD_INDEX REQUIRED_FOR_NON_ROOT_HIERARCHY_NODES
# V0_20_RECEIPT_DIGEST_RECOMPUTED TRUE
# SIGMA_TRANSITION_CHAIN_VERIFIED TRUE
# CANONICAL_GRAPH_AND_LEAF_PATH_REBOUND TRUE
# LIVE_SURFACE /dev/shm/ciel_noema
# STATIC_RUNTIME_FALLBACK FALSE
# EXTERNAL_EFFECTS FALSE
# ALIASES_SEMANTIC_AUTHORITY FALSE
# RUNTIME_LOCATION_SEMANTIC_AUTHORITY FALSE
ASSERT V22.HIERARCHY.IDENTITY
EMIT V22.LINEAGE
