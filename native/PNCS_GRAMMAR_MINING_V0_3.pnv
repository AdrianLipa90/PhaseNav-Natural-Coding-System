PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS grammar-mining pass 01: TIR + Secret of a Half
# No new PNV opcode. Radicals are reusable compositions of existing PNV/1 operators.

# Atomic KAKU candidates recurrent in source-derived paths
OP K.IDENTITY IDENTITY value
OP K.DISTINGUISH DIFFERENCE left right
OP K.COMPOSE COMPOSITION left relation right
OP K.TRANSFORM TRANSFORM source map target
OP K.CONDITION CONDITION subject relation object
OP K.RESOLVE RESOLVE relation
OP K.DERIVE DERIVE premises result

# Supporting KAKU observed in narrower source paths
OP K.BOUNDARY BOUNDARY left right
OP K.NEGATE NEGATION value
OP K.SOURCE SOURCE source
OP K.ORDER ORDER before after
OP K.RETURN RETURN value

# Grammar radicals discovered by recurrence
OP R.FIXED_POINT COMPOSITION K.TRANSFORM K.CONDITION K.RESOLVE
OP R.INVARIANT COMPOSITION K.TRANSFORM K.DISTINGUISH K.IDENTITY
OP R.CANCELLATION COMPOSITION K.COMPOSE K.DISTINGUISH K.IDENTITY
OP R.CONJUGACY COMPOSITION K.TRANSFORM K.COMPOSE K.IDENTITY
OP R.CONVERGENCE COMPOSITION K.DERIVE K.COMPOSE K.IDENTITY K.RESOLVE
OP R.BOUNDARY_TRANSFORM COMPOSITION K.BOUNDARY K.TRANSFORM K.COMPOSE

# Independent source realizations of the same grammar radicals
OP TIR.TRANSLATION_INVARIANCE COMPOSITION R.INVARIANT residual common_shift pairwise_difference
OP TIR.BASELINE_CANCELLATION COMPOSITION R.CANCELLATION same_sector_baseline relative_release baseline_free_relation
OP SOH.COMPLEMENT_FIXED_POINT COMPOSITION R.FIXED_POINT complement one_half half_resolution
OP SOH.SELF_DUAL_FIXED_LOCUS COMPOSITION R.FIXED_POINT reciprocal_conjugate_inversion unit_circle half_axis
OP SOH.INVERSE_BOUNDARY_CONJUGACY COMPOSITION R.CONJUGACY omega critical_reflection reciprocal_conjugate_inversion
OP SOH.HALF_CONVERGENCE COMPOSITION R.CONVERGENCE label_swap reciprocal spinor fisher_rao one_half

# Definition-path candidates: written code can resolve through these instead of inventing keywords.
OP PATH.DEF.FIXED_POINT COMPOSITION K.TRANSFORM K.CONDITION K.RESOLVE
OP PATH.DEF.INVARIANT COMPOSITION K.TRANSFORM K.DISTINGUISH K.IDENTITY
OP PATH.DEF.CANCELLATION COMPOSITION K.COMPOSE K.DISTINGUISH K.IDENTITY
OP PATH.DEF.CONJUGACY COMPOSITION K.TRANSFORM K.COMPOSE K.IDENTITY
OP PATH.DEF.CONVERGENCE COMPOSITION K.DERIVE K.COMPOSE K.IDENTITY K.RESOLVE

VECTOR V.R.FIXED_POINT "PNCS.radical.fixed_point" PRECISE
VECTOR V.R.INVARIANT "PNCS.radical.invariant" PRECISE
VECTOR V.R.CANCELLATION "PNCS.radical.cancellation" PRECISE
VECTOR V.R.CONJUGACY "PNCS.radical.conjugacy" PRECISE
VECTOR V.R.CONVERGENCE "PNCS.radical.convergence" PRECISE

EMIT PATH.DEF.FIXED_POINT
EMIT PATH.DEF.INVARIANT
EMIT PATH.DEF.CANCELLATION
EMIT PATH.DEF.CONJUGACY
EMIT PATH.DEF.CONVERGENCE
