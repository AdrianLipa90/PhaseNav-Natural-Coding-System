PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS v0.8 — predicate composition and two-way branch representation.
# AND/OR/NOT/ELSE remain surface or binding names; no new PNV opcode is introduced.

OP K.DISTINGUISH DIFFERENCE left right
OP K.CONDITION CONDITION predicate relation reference
OP K.ORDER ORDER before after
OP K.TRANSFORM TRANSFORM source map target
OP K.COMPOSE COMPOSITION left relation right
OP K.NEGATE NEGATION predicate

# Predicate-composition radicals.
OP R.COMPARISON COMPOSITION K.DISTINGUISH K.CONDITION
OP R.PREDICATE_AND COMPOSITION predicate_a all predicate_b
OP R.PREDICATE_OR COMPOSITION predicate_a any predicate_b
OP R.PREDICATE_NOT NEGATION predicate

# AND example.
OP EX.AND.TEMP.DELTA DIFFERENCE temperature 80
OP EX.AND.TEMP.PRED CONDITION EX.AND.TEMP.DELTA gt 0
OP EX.AND.MEM.DELTA DIFFERENCE memory_pressure 0.9
OP EX.AND.MEM.PRED CONDITION EX.AND.MEM.DELTA gt 0
OP EX.AND.PRED COMPOSITION EX.AND.TEMP.PRED all EX.AND.MEM.PRED
OP EX.AND.ROUTE TRANSFORM control_location route safety.pause
OP EX.AND.ORDER ORDER EX.AND.PRED EX.AND.ROUTE
OP EX.AND.PROGRAM COMPOSITION EX.AND.PRED EX.AND.ORDER EX.AND.ROUTE

# OR example.
OP EX.OR.RISK.DELTA DIFFERENCE risk 0.8
OP EX.OR.RISK.PRED CONDITION EX.OR.RISK.DELTA gt 0
OP EX.OR.PHASE.DELTA DIFFERENCE phase_coherence 0.7
OP EX.OR.PHASE.PRED CONDITION EX.OR.PHASE.DELTA lt 0
OP EX.OR.PRED COMPOSITION EX.OR.RISK.PRED any EX.OR.PHASE.PRED
OP EX.OR.ROUTE TRANSFORM control_location route safety.pause
OP EX.OR.ORDER ORDER EX.OR.PRED EX.OR.ROUTE
OP EX.OR.PROGRAM COMPOSITION EX.OR.PRED EX.OR.ORDER EX.OR.ROUTE

# Direct NOT example.
OP EX.NOT.RISK.DELTA DIFFERENCE risk 0.8
OP EX.NOT.RISK.PRED CONDITION EX.NOT.RISK.DELTA gt 0
OP EX.NOT.PRED NEGATION EX.NOT.RISK.PRED
OP EX.NOT.ROUTE TRANSFORM control_location route runtime.continue
OP EX.NOT.ORDER ORDER EX.NOT.PRED EX.NOT.ROUTE
OP EX.NOT.PROGRAM COMPOSITION EX.NOT.PRED EX.NOT.ORDER EX.NOT.ROUTE

# IF/ELSE bifurcation. ELSE is bound to the negated primary predicate.
OP EX.ELSE.RISK.DELTA DIFFERENCE risk 0.8
OP EX.ELSE.RISK.PRED CONDITION EX.ELSE.RISK.DELTA gt 0
OP EX.ELSE.FALSE_PRED NEGATION EX.ELSE.RISK.PRED
OP EX.ELSE.TRUE_ROUTE TRANSFORM control_location route safety.pause
OP EX.ELSE.FALSE_ROUTE TRANSFORM control_location route runtime.continue
OP EX.ELSE.TRUE_ORDER ORDER EX.ELSE.RISK.PRED EX.ELSE.TRUE_ROUTE
OP EX.ELSE.FALSE_ORDER ORDER EX.ELSE.FALSE_PRED EX.ELSE.FALSE_ROUTE
OP EX.ELSE.PROGRAM COMPOSITION EX.ELSE.TRUE_ORDER branch EX.ELSE.FALSE_ORDER

EMIT "PNCS_V0_8_LOGIC_BRANCHING_READY"
