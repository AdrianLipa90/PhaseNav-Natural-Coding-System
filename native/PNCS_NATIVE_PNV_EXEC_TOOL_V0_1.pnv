PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNCS native PNV execution-tool contract.
# Executes admitted PNV1 relational programs through an explicit opcode/interpreter boundary.

OP PNVEXEC.SOURCE.IDENTITY SOURCE admitted_pnv_source_sha256
OP PNVEXEC.PARSE.IDENTITY IDENTITY parsed_pnv_graph_identity
OP PNVEXEC.SEMANTICS.ORDER ORDER admitted_source_bindings admitted_comparator_registry admitted_transform_registry
OP PNVEXEC.EXECUTION.TRANSFORM TRANSFORM PNVEXEC.PARSE.IDENTITY execute_admitted_pnv_graph
OP PNVEXEC.RECEIPT.COMPOSE COMPOSITION PNVEXEC.SOURCE.IDENTITY PNVEXEC.SEMANTICS.ORDER PNVEXEC.EXECUTION.TRANSFORM
OP PNVEXEC.RETURN RETURN PNVEXEC.RECEIPT.COMPOSE

ASSERT PNVEXEC.SOURCE.IDENTITY
ASSERT PNVEXEC.PARSE.IDENTITY
EMIT PNVEXEC.RETURN

# TOOL_SCOPE POST_V1_EXPERIMENTAL
# PNV_VERSION 1
# UNKNOWN_OPCODE FAIL_CLOSED
# UNKNOWN_SOURCE FAIL_CLOSED
# UNKNOWN_COMPARATOR FAIL_CLOSED
# UNKNOWN_TRANSFORM FAIL_CLOSED
# EXTERNAL_SEMANTICS EXPLICIT_INJECTION_ONLY
# SHELL FALSE
# SUBPROCESS FALSE
# NETWORK FALSE
# GIT FALSE
# DEVICE FALSE
# ARBITRARY_FILESYSTEM FALSE
# EXTERNAL_EFFECTS FALSE
# RECEIPT DETERMINISTIC_SHA256
# STATIC_RUNTIME_FALLBACK FALSE
# RELEASE_GATE_AUTHORITY FALSE
# NEW_PNV_OPCODES 0
