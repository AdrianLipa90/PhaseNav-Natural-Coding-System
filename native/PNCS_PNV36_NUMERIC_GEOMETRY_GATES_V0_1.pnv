PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# NATIVE NUMERIC CONTRACT (not a claim that numeric callbacks exist).
# atan2 must be quadrant-aware and handle signed axes, finite inputs, 0/0.
# Wrapped geodesic distance must reject anything except exact 36 finite angles.
# A native interpreter MUST reject unresolved semantic transforms (fail-closed).
# NO_PYTHON_BACKEND_PERMITTED TRUE
# PRODUCTION_STATUS BLOCKED_PENDING_IMPLEMENTATION_AND_RECEIPTS

OP GEOMETRY.THETA.X SOURCE ordered_phase_vector_x
OP GEOMETRY.THETA.Y SOURCE ordered_phase_vector_y
OP GEOMETRY.X36 CONDITION GEOMETRY.THETA.X exactly_36_finite_angles
OP GEOMETRY.Y36 CONDITION GEOMETRY.THETA.Y exactly_36_finite_angles
OP GEOMETRY.PAIR.ADMISSION COMPOSITION GEOMETRY.X36 GEOMETRY.Y36
OP GEOMETRY.ANGLE.SIN SOURCE signed_sine_component
OP GEOMETRY.ANGLE.COS SOURCE signed_cosine_component
OP GEOMETRY.ATAN2 TRANSFORM GEOMETRY.ANGLE.SIN GEOMETRY.ANGLE.COS quadrant_aware_atan2
OP GEOMETRY.DELTA DIFFERENCE GEOMETRY.THETA.X GEOMETRY.THETA.Y
OP GEOMETRY.WRAP TRANSFORM GEOMETRY.DELTA shortest_wrapped_tangent36 wrapped_delta36
OP GEOMETRY.NORM TRANSFORM GEOMETRY.WRAP euclidean_norm_36d geodesic_distance
OP GEOMETRY.CHECK COMPOSITION GEOMETRY.PAIR.ADMISSION GEOMETRY.ATAN2 GEOMETRY.NORM
ASSERT GEOMETRY.X36 GEOMETRY.Y36
EMIT GEOMETRY.CHECK

# REQUIRED_CASE atan2(1,1)=pi/4
# REQUIRED_CASE atan2(1,-1)=3*pi/4
# REQUIRED_CASE atan2(-1,-1)=-3*pi/4
# REQUIRED_CASE atan2(-1,1)=-pi/4
# REQUIRED_CASE vector length 35 or 37 => REJECT
# REQUIRED_CASE periodic wrap (a+2pi*k,b) == (a,b)
# RECEIPT_STATUS NOT_EXECUTED
