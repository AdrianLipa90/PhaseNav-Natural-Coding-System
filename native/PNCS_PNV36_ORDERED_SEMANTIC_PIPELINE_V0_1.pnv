PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# Native operator-only order witness. This file does not use Python callbacks.
# Tokenization, lexical negation and exact T36 address calculation are NOT
# implemented in current admitted PNV/1 built-ins.
# RELEASE_STATUS BLOCKED_MISSING_NATIVE_SEMANTIC_OPERATORS
OP TOKEN.A SOURCE 1
OP TOKEN.B SOURCE 2
OP TOKEN.ORDERED ORDER TOKEN.A TOKEN.B
OP TOKEN.REVERSED ORDER TOKEN.B TOKEN.A
OP TOKEN.ORDERED.IDENTITY IDENTITY TOKEN.ORDERED TOKEN.ORDERED
OP TOKEN.ORDER.DIFFERENCE DIFFERENCE TOKEN.ORDERED TOKEN.REVERSED
OP SEMANTIC.LINEAGE COMPOSITION TOKEN.ORDERED TOKEN.ORDER.DIFFERENCE
ASSERT TOKEN.ORDERED.IDENTITY
EMIT SEMANTIC.LINEAGE TOKEN.ORDER.DIFFERENCE
