PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# Native ordered-semantic PhaseNav->PNCS->QHTRI boundary.
# This graph preserves token order and maintains explicit admission boundaries.
# Source bindings and transforms MUST be provided by an approved native runtime.
# No Python callback or Python file is part of this program.
# STATUS: NATIVE_SOURCE_ONLY; EXECUTION_NOT_PROVEN.

OP TOKEN.SURFACE SOURCE original_sentence_utf8
OP TOKEN.BOUNDARY TRANSFORM TOKEN.SURFACE punctuation_aware_token_boundaries token_sequence
OP TOKEN.CASE TRANSFORM TOKEN.BOUNDARY unicode_casefold canonical_token_sequence
OP TOKEN.ORDER ORDER canonical_token_sequence ordered_token_positions
OP TOKEN.NEGATION TRANSFORM TOKEN.CASE lexical_negation_under_punctuation negation_flags
OP CONTENT.IDENTITY TRANSFORM TOKEN.ORDER ordered_semantic_content_address typed_content_id
OP PHASE.ADDRESS TRANSFORM CONTENT.IDENTITY exact_t36_realization phase36
OP PHASE.WIDTH CONDITION phase36 exact_36_finite_angles
OP PHASE.BIND COMPOSITION CONTENT.IDENTITY PHASE.ADDRESS
OP ORDERED.SEMANTICS COMPOSITION TOKEN.ORDER TOKEN.NEGATION PHASE.BIND
OP HTRI.ADMISSION CONDITION ORDERED.SEMANTICS explicitly_admitted_t36_input
OP QHTRI.DRIVE TRANSFORM HTRI.ADMISSION ordered_t36_to_htri_drive qhtri_drive_candidate
OP EFFECT.BOUNDARY CONDITION QHTRI.DRIVE no_external_effects_without_authorization
ASSERT PHASE.WIDTH
EMIT ORDERED.SEMANTICS HTRI.ADMISSION EFFECT.BOUNDARY

# UNKNOWN_TOKEN_HANDLING FAIL_CLOSED
# NONCOMMUTATIVE_TOKEN_ORDER PRESERVED
# EXACT_36D_CONTRACT MANDATORY
# NEGATION_PUNCTUATION CONTRACT_MANDATORY
# QHTRI_PHYSICAL_VALIDATION NOT_CLAIMED
# RELEASE_ADMISSION BLOCKED_UNTIL_NATIVE_EXECUTION_EVIDENCE
