PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNCS_QUANTUM_APPLICATION_RUNTIME_V0_31
# Canonical rule: preserve full PhaseNav/tensor/scalar state until an explicit observation boundary.
# Boolean results are boundary projections, not the internal ontology of the application.

CONTRACT PNCS_QUANTUM_APPLICATION_RUNTIME_V0_31
STATUS CANDIDATE_NO_EARLY_COLLAPSE
EXECUTION LOCAL_FIRST
REMOTE_RUNTIME REQUIRED_FALSE
PHASENAV_SPACE T36
STATE_KIND QUANTUM_APPLICATION_STATE
STATE_COMPONENTS PHI36,AMPLITUDE_FIELD,RELATION_TENSOR,SCALAR_FIELDS,TAU,RESIDUAL_FIELD,PROVENANCE
BACKENDS CLASSICAL_PHASE_SIMULATION,ANALOG_PHASE_RUNTIME,QPU_PHYSICAL
PHYSICAL_QUANTUM_CLAIM DEFAULT_FALSE

OP APP.STATE SOURCE PNCS_QUANTUM_APPLICATION_STATE
OP APP.EVOLVE ORDER APP.STATE preserve_full_state
OP APP.PHASE TRANSFORM APP.EVOLVE phasenav_operator
OP APP.RELATION TRANSFORM APP.PHASE relation_tensor_operator
OP APP.SCALAR TRANSFORM APP.RELATION scalar_field_operator
OP APP.RESIDUAL TRANSFORM APP.SCALAR preserve_uncertainty_and_residuals
OP APP.PREMEASUREMENT COMPOSITION APP.PHASE APP.RELATION APP.SCALAR APP.RESIDUAL
OP APP.MEASUREMENT.ORDER ORDER APP.PREMEASUREMENT explicit_observation_boundary_only
OP APP.MEASUREMENT TRANSFORM APP.MEASUREMENT.ORDER declared_measurement_channel
OP APP.CLASSICAL.CONDITION CONDITION APP.MEASUREMENT declared_outcome_space
OP APP.RETURN RETURN APP.CLASSICAL.CONDITION

ASSERT APP.STATE
ASSERT APP.PREMEASUREMENT
ASSERT APP.MEASUREMENT.ORDER
EMIT APP.RETURN

# NEVER_COLLAPSE_EARLY TRUE
# BOOLEAN_INTERNAL_ONTOLOGY FALSE
# BOOLEAN_BOUNDARY_PROJECTION TRUE
# PASS_FAIL_BOUNDARY_ONLY TRUE
# UNRESOLVED_TO_FALSE_IMPLICIT FALSE
# PROVENANCE_SURVIVES_MEASUREMENT TRUE
# FAIL_CLOSED_SAFETY_BOUNDARIES TRUE
# PYTHON_SEMANTIC_AUTHORITY FALSE
# PYTHON_REFERENCE_ADAPTER_ALLOWED TRUE
# NEW_PNV_OPCODES 0
