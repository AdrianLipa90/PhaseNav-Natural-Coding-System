PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS v0.9 — explicit grouping and recursive predicate trees.
# Parentheses, AND, OR, NOT, IF, THEN, ELSE and GO are surface structure/bindings.
# No new PNV opcode is introduced and no implicit mixed-operator precedence is assumed.

OP K.DISTINGUISH DIFFERENCE left right
OP K.CONDITION CONDITION predicate relation reference
OP K.ORDER ORDER before after
OP K.TRANSFORM TRANSFORM source map target
OP K.COMPOSE COMPOSITION left relation right
OP K.NEGATE NEGATION predicate

OP R.COMPARISON COMPOSITION K.DISTINGUISH K.CONDITION
OP R.PREDICATE_AND COMPOSITION predicate_a all predicate_b
OP R.PREDICATE_OR COMPOSITION predicate_a any predicate_b
OP R.PREDICATE_NOT NEGATION predicate
OP R.CONDITIONAL_ROUTE COMPOSITION R.COMPARISON K.ORDER K.TRANSFORM K.COMPOSE

# Recursive example: (A AND B) OR (C AND NOT D)
OP EX.V09.A.DELTA DIFFERENCE temperature 80
OP EX.V09.A CONDITION EX.V09.A.DELTA gt 0
OP EX.V09.B.DELTA DIFFERENCE memory_pressure 0.9
OP EX.V09.B CONDITION EX.V09.B.DELTA gt 0
OP EX.V09.AB COMPOSITION EX.V09.A all EX.V09.B

OP EX.V09.C.DELTA DIFFERENCE risk 0.8
OP EX.V09.C CONDITION EX.V09.C.DELTA gt 0
OP EX.V09.D.DELTA DIFFERENCE phase_coherence 0.7
OP EX.V09.D CONDITION EX.V09.D.DELTA lt 0
OP EX.V09.NOT_D NEGATION EX.V09.D
OP EX.V09.C_NOT_D COMPOSITION EX.V09.C all EX.V09.NOT_D

OP EX.V09.ROOT COMPOSITION EX.V09.AB any EX.V09.C_NOT_D
OP EX.V09.ROUTE TRANSFORM control_location route safety.pause
OP EX.V09.ORDER ORDER EX.V09.ROOT EX.V09.ROUTE
OP EX.V09.PROGRAM COMPOSITION EX.V09.ROOT EX.V09.ORDER EX.V09.ROUTE

# Homogeneous N-ary chain. Same-kind conjunction is a recursive/flattenable composition.
OP EX.V09.NARY.P12 COMPOSITION predicate_1 all predicate_2
OP EX.V09.NARY.P123 COMPOSITION EX.V09.NARY.P12 all predicate_3
OP EX.V09.NARY.P1234 COMPOSITION EX.V09.NARY.P123 all predicate_4

# IF/ELSE remains a pair of complementary routes; false branch binds NEGATION(root).
OP EX.V09.FALSE_ROOT NEGATION EX.V09.ROOT
OP EX.V09.TRUE_ROUTE TRANSFORM control_location route safety.pause
OP EX.V09.FALSE_ROUTE TRANSFORM control_location route runtime.continue
OP EX.V09.TRUE_ORDER ORDER EX.V09.ROOT EX.V09.TRUE_ROUTE
OP EX.V09.FALSE_ORDER ORDER EX.V09.FALSE_ROOT EX.V09.FALSE_ROUTE
OP EX.V09.BIFURCATION COMPOSITION EX.V09.TRUE_ORDER branch EX.V09.FALSE_ORDER

EMIT "PNCS_V0_9_RECURSIVE_GROUPING_READY"
