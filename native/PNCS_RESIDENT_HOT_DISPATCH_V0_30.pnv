PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# PNCS v0.30 resident hot-dispatch candidate.
# Full v0.25 admission is required before this bounded transition can exist.

OP V30.LIVE.SURFACE SOURCE /dev/shm/ciel_noema
OP V30.RESIDENT.IDENTITY IDENTITY resident_handle fully_admitted_resident_handle
OP V30.GENERATION.CONDITION CONDITION generation_identity unchanged
OP V30.AUTHORITY.CONDITION CONDITION authority_file_identity unchanged
OP V30.HEARTBEAT.CONDITION CONDITION live_producers fresh_and_alive
OP V30.GUARD.ORDER ORDER V30.GENERATION.CONDITION V30.AUTHORITY.CONDITION
OP V30.GUARD.ORDER2 ORDER V30.GUARD.ORDER V30.HEARTBEAT.CONDITION
OP V30.INTERNAL.TRANSFORM TRANSFORM admitted_control_root V30.GUARD.ORDER2
OP V30.CLOSE COMPOSITION V30.RESIDENT.IDENTITY V30.INTERNAL.TRANSFORM

ASSERT V30.RESIDENT.IDENTITY
ASSERT V30.GENERATION.CONDITION
ASSERT V30.AUTHORITY.CONDITION
ASSERT V30.HEARTBEAT.CONDITION
EMIT V30.CLOSE

# FULL_ADMISSION_REQUIRED TRUE
# HOT_GUARD_BEFORE TRUE
# HOT_GUARD_AFTER TRUE
# AUTOMATIC_TOKEN_REFRESH FALSE
# LIVE_SURFACE_REQUIRED TRUE
# STATIC_RUNTIME_FALLBACK FALSE
# EXTERNAL_EFFECTS FALSE
# FREE_FORM_NL_EXECUTION FALSE
# RECEIPT CONTENT_ADDRESSED
