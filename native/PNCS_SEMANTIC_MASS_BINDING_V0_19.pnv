PNV 1
EPISTEMIC CHYBA
MODE READ_ONLY

# PNCS v0.19 semantic-mass binding witness.
# The mass scalar is bound to an existing exact 36D realization and an explicit positive phase index.

OP V19.MASS.CONTRACT SOURCE PNV_SEMANTIC_MASS_V1
OP V19.RUNTIME.SOURCE SOURCE sha256:0b4df86cd01db313ea46ebac0eceee9cf6df0673391edd1a3fb2667c30464a32
OP V19.SEMANTIC.CONTENT SOURCE pncs:def:sha256:registered-content
OP V19.REALIZATION SOURCE pncs:realization36:sha256:registered-realization
OP V19.PHASE.INDEX SOURCE explicit-positive-integer-k
OP V19.ORDER.PARAMETER SOURCE R_k_from_exact_T36_realization
OP V19.MASS.BINDING COMPOSITION V19.SEMANTIC.CONTENT V19.REALIZATION V19.PHASE.INDEX V19.ORDER.PARAMETER V19.MASS.CONTRACT V19.RUNTIME.SOURCE
OP V19.CONTENT.IDENTITY IDENTITY V19.SEMANTIC.CONTENT pncs:def:sha256:registered-content

# FORMULA m_k = kappa*(1 + alpha_M*k) + (L4/L3)*R_k
# PHASE_INDEX EXPLICIT_POSITIVE_INTEGER
# MASS_EQUALITY_SEMANTIC_AUTHORITY FALSE
# PHYSICAL_MASS_CLAIM FALSE
ASSERT V19.CONTENT.IDENTITY
EMIT V19.MASS.BINDING
