PNV 1
EPISTEMIC CHYBA
MODE INTERNAL_EXECUTION

# A0 -> Hotel Hilberta; native PNV/1-subset, typed source bindings are explicit.
# Eight sources, nine registered pure native maps, no side effects.
# TER=(-1, 0(+i,-i), +1). HOLD keeps coherent +/-i pair.
# Phase36 float64 is independent of TER12 int8 and is never projected into it.
OP A0 SOURCE RDSS_A0_AXIOM
OP A SOURCE RDSS_A_EQUALS_I
OP PHASE SOURCE EXPLICIT_PHASE36_INPUT
OP TER SOURCE EXPLICIT_TER12_INPUT
OP DEPTH SOURCE HILBERT_DEPTH_INPUT
OP COLSEED SOURCE COLLATZ_SEED_INPUT
OP GAUSS SOURCE RDSS_BOMBELLI_2_PLUS_I
OP BERRYPATH SOURCE RDSS_EQUATORIAL_CLOSED_PATH
OP FIRST ORDER A0 A
OP V36 TRANSFORM PHASE PHASENAV_AVX2_PHASE36_PI unwrapped_phase36
OP TERNARY TRANSFORM TER PHASENAV_AVX2_TER12 signed_ternary12
OP SPIN TRANSFORM A RDSS_EULER_SPIN_BERRY spinor_berry
OP ZERO TRANSFORM SPIN RDSS_INVERSE_SQUARE_SINGULARITY singularity
OP TREE TRANSFORM ZERO RDSS_HILBERT_EULER_TREE hilbert_tree
OP TZIM TRANSFORM TREE RDSS_TZIMTZUM_INV_SQUARE contraction_scaling
OP WORD TRANSFORM TZIM RDSS_SELF_REFERENCE_WORD typed_self_reference
OP COL TRANSFORM WORD RDSS_BOMBELLI_COLLATZ_TRACE tagged_collatz
OP HOTEL TRANSFORM COL RDSS_HILBERT_GUEST_REGISTER guest
OP PHASE_REL COMPOSITION V36 TERNARY SPIN
OP HISTORY_REL COMPOSITION TREE COL HOTEL
OP SYSTEM COMPOSITION FIRST PHASE_REL HISTORY_REL
ASSERT SYSTEM
EMIT SYSTEM
